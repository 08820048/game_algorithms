---
/** 站点标识：主题色印章 + 宋体书名 + 系列中的册名（橙皮书 / 绿皮书 / 蓝皮书） */
import { book } from '../../data/book';
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title">
	<span class="seal" aria-hidden="true">{book.seal}</span>
	<span class="name" translate="no">{siteTitle}</span>
	<span class="edition">{book.edition}</span>
</a>

<style>
	.site-title {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		min-width: 0;
		text-decoration: none;
		color: var(--sl-color-white);
		white-space: nowrap;
	}
	.seal {
		display: grid;
		place-items: center;
		flex-shrink: 0;
		width: 1.75rem;
		height: 1.75rem;
		border-radius: 2px;
		background: var(--book-accent);
		color: #fbf9f4;
		font-family: var(--ga-font-serif);
		font-size: 1rem;
		font-weight: 700;
		line-height: 1;
	}
	.name {
		overflow: hidden;
		font-family: var(--ga-font-serif);
		font-size: 1.125rem;
		font-weight: 700;
		letter-spacing: 0.04em;
	}
	.edition {
		flex-shrink: 0;
		padding: 0.1rem 0.4rem;
		border: 1px solid var(--book-accent);
		border-radius: 2px;
		color: var(--book-accent);
		font-size: 0.6875rem;
		letter-spacing: 0.12em;
		line-height: 1.4;
	}
	@media (max-width: 22rem) {
		.edition {
			display: none;
		}
	}
</style>
